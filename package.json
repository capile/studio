{
    "name": "Studio",
    "version": "2.1.X",
    "description": "Own your data!",
    "main": "studio.js",
    "author": "Guilherme Capilé",
    "dependencies": {
        "@fortawesome/fontawesome-free": "5.*",
        "billboard.js": "^3.16.0",
        "d3": "*",
        "less": "*",
        "moment": "^2.30.1",
        "node-ipc": "^9.1.4",
        "pell": "1.0.*",
        "pikaday-time": "^1.6.1",
        "sass": "*",
        "topojson-client": "^3.1.0",
        "topojson-simplify": "^3.0.3",
        "uglify-js": "^3.19"
    },
    "scripts": {
        "composer-install": "docker run -it -u 0 -v $PWD:/var/www/studio:z tecnodesign/studio:v2 composer install --no-dev --ignore-platform-req=ext-zip",
        "composer-update":  "docker run -it -u 0 -v $PWD:/var/www/studio:z tecnodesign/studio:v2 composer update --no-dev --ignore-platform-req=ext-zip",
        "build": "docker build -t tecnodesign/studio:v2 -t tecnodesign/studio:v2.1 -t tecnodesign/studio:latest 'git@github.com:capile/studio.git#main'",
        "build-local": "docker build -t tecnodesign/studio:latest .",
        "start": "electron ."
    },
    "license": "GPL-3.0-only"
}
